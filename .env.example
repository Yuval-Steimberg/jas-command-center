# ── Command center's OWN Supabase project (login, roles, audit). Required in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Local development only (ignored in production builds and when Supabase is set)
CC_DEV_PASSWORD=
CC_SESSION_SECRET=            # 32+ random characters

# ── Website & shop (just-a-second-website)
WEBSITE_URL=                  # production origin of the website deployment
WEBSITE_AGENT_API_KEY=        # = AGENT_API_KEY on the website (24+ chars). Read-only snapshot access.
WEBSITE_COMMAND_CENTER_KEY=   # = COMMAND_CENTER_API_KEY on the website (32+ chars). Orders + products pages. A DIFFERENT value from the agent key.

# ── Gift cards (gift_card_system)
GIFT_CARDS_URL=               # e.g. https://gift.justasecond.co.il
GIFT_CARDS_INTEGRATION_KEY=   # = INTEGRATION_API_KEY on the gift card deployment (32+ chars)

# ── Furniture collection (Furniture-Collect) — its own Supabase project
FURNITURE_SUPABASE_URL=
FURNITURE_SUPABASE_KEY=       # server-only. Interim: service role. Preferred: a read-only role (see docs/DEPLOYMENT.md)
FURNITURE_APP_URL=            # optional: the field app's URL, for the availability probe and links

# ── Design agent (whatssup-bot on Railway)
DESIGN_AGENT_URL=             # the Railway public domain
DESIGN_AGENT_ADMIN_TOKEN=     # = ADMIN_TOKEN on the bot

# ── Interactive map
GITHUB_TOKEN=                 # fine-grained, Interactive-map only: Contents + Pull requests read/write (place edits open a PR)
MAP_GA4_PROPERTY_ID=          # numeric GA4 property id of the map (Admin > Property details), not G-0EM74CEJ0J
GA4_SERVICE_ACCOUNT_JSON=     # service-account key file (JSON or base64); add its email as Viewer on the property
MAP_SITE_URL=                 # default https://map.justasecond.co.il
MAP_GITHUB_REPO=              # default Yuval-Steimberg/Interactive-map
MAP_GITHUB_BRANCH=            # default main

# ── AI assistant (read-only; calls only the permission-checked tools in lib/assistant/tools.ts)
ANTHROPIC_API_KEY=            # console.anthropic.com → API Keys. Set a monthly spend limit there.
ASSISTANT_MODEL=              # default claude-opus-5-5
